{
  "name": "tokendiff",
  "version": "0.1.0",
  "private": true,
  "description": "Advisory AI pipeline efficiency reviews for pull requests",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:bundle": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval:live": "node --import tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@google/genai": "^2.31.0",
    "diff": "^9.0.0",
    "minimatch": "^10.2.6",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
